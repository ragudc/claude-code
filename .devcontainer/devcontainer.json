{
  "name": "Platziflix Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // Montar el socket de Docker del host para usar Docker-in-Docker
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],

  // Variables de entorno disponibles en el contenedor
  "containerEnv": {
    "NODE_ENV": "development"
  },

  // Puertos expuestos: Backend (8000), Frontend (3000), PostgreSQL (5432)
  "forwardPorts": [3000, 8000, 5432],
  "portsAttributes": {
    "3000": { "label": "Frontend (Next.js)", "onAutoForward": "notify" },
    "8000": { "label": "Backend (FastAPI)", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },

  // Extensiones de VS Code recomendadas para el proyecto
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "typescript.preferences.importModuleSpecifier": "relative"
      }
    }
  },

  // Comandos que se ejecutan una vez creado el contenedor
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Correr como usuario no-root
  "remoteUser": "node"
}
